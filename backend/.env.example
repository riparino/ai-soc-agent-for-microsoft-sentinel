# ==============================================================================
# Microsoft Sentinel AI SOC Agent - per-analyst MCP server configuration
# Copy to backend/.env (never commit .env). Only the first block needs editing.
# ==============================================================================

# --- You: the signed-in analyst ---------------------------------------------
# The server authenticates as YOU via `az login` (no secrets on this machine) and
# your Lighthouse-delegated Microsoft Sentinel Responder role applies everywhere.
DEMO_MODE=False
AZURE_AUTH_MODE=user
AZURE_TENANT_ID="<managing-tenant-id>"
# Open a browser to sign in when no Azure CLI session exists (otherwise: az login).
AZURE_INTERACTIVE_LOGIN=False

# --- Your customer workspaces -------------------------------------------------
# Generated by:  ./run-mcp.sh --discover-workspaces   (Windows: .\run-mcp.ps1 ...)
# Coordinates only, no secrets. Re-run when a customer is added or removed.
WORKSPACES_CONFIG_PATH=./workspaces.json

# --- Optional: server-side LLM ------------------------------------------------
# Not needed for MCP use: your MCP client (Claude, Copilot...) is the reasoning
# engine and sentinel_triage_incident returns an evidence pack. Configure one of
# these only if you want the server itself to write the verdict.
LLM_PROVIDER="azure_openai"
# AZURE_OPENAI_ENDPOINT="https://<resource>.openai.azure.com/"
# AZURE_OPENAI_API_KEY=""
# AZURE_OPENAI_DEPLOYMENT_NAME="gpt-5.2"
# AZURE_OPENAI_API_VERSION="2024-05-01-preview"
# OPENAI_API_KEY=""

# --- Optional: external threat intelligence -----------------------------------
# Without keys the lookup tools return status NOT_CONFIGURED (never a fake score).
# Sentinel's own TI tables are hunted regardless.
# ABUSEIPDB_API_KEY=""
# VIRUSTOTAL_API_KEY=""
ENABLE_MICROSOFT_THREAT_INTEL=True

# --- Behaviour ----------------------------------------------------------------
# Triage claims an unassigned incident for you first (Sentinel owner = the lock) and
# skips incidents that were AI-triaged within TRIAGE_DEDUPE_MINUTES unless forced.
TRIAGE_CLAIM_ON_RUN=True
TRIAGE_DEDUPE_MINUTES=30
# Post the AI report as an incident comment (only when the server produced a verdict).
AUTO_POST_COMMENTS_TO_SENTINEL=True
AUTO_CLOSE_FALSE_POSITIVES=False
# Hunting: tables are read from each workspace's Usage table over this many days;
# at most HUNT_MAX_QUERIES catalog hunts run per triage, HUNT_MAX_ROWS rows each.
HUNT_TABLE_LOOKBACK_DAYS=7
HUNT_MAX_QUERIES=12
HUNT_MAX_ROWS=25

# --- Advanced: hosting the server for a team over HTTP (not needed locally) -----
# See docs/MCP_SERVER.md and docs/COPILOT_STUDIO.md. stdio (the default) ignores these.
MCP_AUTH_MODE=none
MCP_HOST=127.0.0.1
MCP_PORT=8800
# MCP_PUBLIC_URL="https://soc-mcp.example.com/mcp"
# MCP_ENTRA_TENANT_ID=""        # defaults to AZURE_TENANT_ID
# MCP_ENTRA_AUDIENCE=""         # app (client) id of the MCP server registration
# MCP_REQUIRED_SCOPES="Sentinel.Triage"
# MCP_DISABLED_TOOLS="sentinel_check_ip_reputation,sentinel_check_file_hash"

# --- Server deployments only (service principal / managed identity) ----------
# Leave empty on analyst machines.
# AZURE_CLIENT_ID=""
# AZURE_CLIENT_SECRET=""
# USE_MANAGED_IDENTITY=False
