# ==============================================================================
# Microsoft Sentinel AI SOC Agent - Environment Configuration Template
# ==============================================================================

# Application Configuration
APP_NAME="Microsoft Sentinel AI Triage Platform"
APP_ENV=production
DEBUG=False
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["*"]

# JWT Authentication
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
ADMIN_USERNAME=soc_admin
ADMIN_PASSWORD=SentinelAdmin2026!

# Managing (home) tenant service principal credentials.
# Under Azure Lighthouse this single SP reaches ARM + Log Analytics across ALL
# delegated customer subscriptions, so it is shared by the whole workspace fleet.
AZURE_TENANT_ID="YOUR_AZURE_TENANT_ID"
AZURE_CLIENT_ID="YOUR_AZURE_CLIENT_ID"
AZURE_CLIENT_SECRET="YOUR_AZURE_CLIENT_SECRET"
USE_MANAGED_IDENTITY=False

# Single / default workspace coordinates (managing tenant). These are used when the
# multi-workspace fleet registry below is NOT configured (backward compatible).
AZURE_SUBSCRIPTION_ID="YOUR_AZURE_SUBSCRIPTION_ID"
AZURE_RESOURCE_GROUP_NAME="YOUR_RESOURCE_GROUP"
AZURE_WORKSPACE_NAME="YOUR_WORKSPACE_NAME"
AZURE_WORKSPACE_ID="YOUR_LOG_ANALYTICS_WORKSPACE_GUID"

# ------------------------------------------------------------------------------
# Multi-workspace / multi-tenant fleet (Azure Lighthouse). See docs/MULTI_TENANT.md.
# Define the full fleet of delegated Sentinel workspaces as EITHER an inline JSON
# array (WORKSPACES_JSON) OR a path to a JSON file (WORKSPACES_CONFIG_PATH, scales
# to ~hundreds of entries — see workspaces.example.json). When neither is set the
# registry falls back to the single AZURE_* workspace above.
#
# NOTE: Azure Lighthouse delegates ARM + Log Analytics only, NOT Microsoft Graph.
# For identity features (list users, revoke sessions, disable account) in a
# delegated tenant, add a per-customer Graph app (graph_tenant_id / graph_client_id
# / graph_client_secret) to that workspace entry; otherwise those features are
# scoped to SigninLogs telemetry / the managing tenant.
# WORKSPACES_CONFIG_PATH="./workspaces.json"
# WORKSPACES_JSON=[{"id":"contoso","display_name":"Contoso","tenant_id":"...","subscription_id":"...","resource_group":"...","workspace_name":"contoso-sentinel"}]

# Live / Demo Mode (Set False for live Microsoft Sentinel connection)
DEMO_MODE=False

# Azure OpenAI Configuration
LLM_PROVIDER="azure_openai"
AZURE_OPENAI_ENDPOINT="https://YOUR_AOAI_RESOURCE.openai.azure.com/"
AZURE_OPENAI_API_KEY="YOUR_AZURE_OPENAI_KEY"
AZURE_OPENAI_DEPLOYMENT_NAME="gpt-5.2"
AZURE_OPENAI_API_VERSION="2024-05-01-preview"

# External Threat Intelligence API Keys (Optional)
ABUSEIPDB_API_KEY=""
VIRUSTOTAL_API_KEY=""
ENABLE_MICROSOFT_THREAT_INTEL=True

# Auto-Triage & Sentinel Comment Synchronization
AUTO_POST_COMMENTS_TO_SENTINEL=True
AUTO_CLOSE_FALSE_POSITIVES=False
